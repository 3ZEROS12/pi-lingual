{
  "name": "pi-lingual",
  "version": "0.5.4",
  "description": "Bilingual developer companion & Prompt Optimizer for Pi — [1] 0ms Companion Cards (slots), [2] Dedicated 1-to-1 Logical Structuring (directSlots), [3] 3-Angle Engineering Candidates (promptSlots), and [0] Zero-Footprint Off Mode (off).",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "bin",
    "skills",
    "assets",
    "README.md",
    "README_zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "lingual": "bin/lingual.js"
  },
  "pi": {
    "extensions": [
      "dist/extension.js"
    ],
    "skills": [
      "skills/lingual-tuner"
    ],
    "image": "https://raw.githubusercontent.com/3ZEROS12/pi-lingual/main/assets/demo-animated-en.svg"
  },
  "scripts": {
    "build": "tsup src/index.ts src/extension.ts src/core/index.ts --format esm,cjs --dts --clean --no-splitting",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "npx tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "translate",
    "translator",
    "translation",
    "developer-translate",
    "ai-translate",
    "pi-translate",
    "developer-english",
    "spoken-english",
    "technical-writing",
    "coding-agent",
    "developer-tools",
    "bilingual",
    "prompt-enhancement"
  ],
  "author": "Jason Song <jiaxinsong312@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3ZEROS12/pi-lingual.git"
  },
  "bugs": {
    "url": "https://github.com/3ZEROS12/pi-lingual/issues"
  },
  "homepage": "https://github.com/3ZEROS12/pi-lingual#readme",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "^26.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
